{
  "name": "@devwithkd/foundation",
  "version": "0.1.0",
  "description": "Layered-architecture building blocks for Next.js apps: server action and route adapters, authz, list/query contracts, Drizzle repositories, audit, Redis and React helpers. Ships TypeScript source.",
  "keywords": [
    "nextjs",
    "server-actions",
    "drizzle",
    "better-auth",
    "tanstack-query",
    "audit",
    "architecture"
  ],
  "license": "MIT",
  "author": "Kedar Joshi",
  "homepage": "https://github.com/devWithKD/next-foundation#readme",
  "bugs": {
    "url": "https://github.com/devWithKD/next-foundation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devWithKD/next-foundation.git",
    "directory": "packages/foundation"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    "./errors": "./src/errors/index.ts",
    "./result": "./src/result/index.ts",
    "./env": "./src/env/index.ts",
    "./logger": "./src/logger/index.ts",
    "./authz": "./src/authz/index.ts",
    "./list": "./src/list/index.ts",
    "./query": "./src/query/index.ts",
    "./context": "./src/context/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./better-auth": "./src/better-auth/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./db": "./src/db/index.ts",
    "./redis": "./src/redis/index.ts",
    "./redis/ioredis": "./src/redis/ioredis.ts",
    "./redis/upstash": "./src/redis/upstash.ts",
    "./cache": "./src/cache/index.ts",
    "./audit": "./src/audit/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.100",
    "@upstash/redis": ">=1.39",
    "better-auth": ">=1.7",
    "drizzle-orm": ">=1.0.0-rc.4",
    "ioredis": ">=5",
    "next": ">=16.3",
    "react": ">=19.2",
    "server-only": ">=0.0.1",
    "zod": ">=4.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "1.0.0-rc.4",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
